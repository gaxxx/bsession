#!/usr/bin/env bash
# Host-side wrapper for bsession.
#
# Default (Docker mode): forwards to lib/cli.py inside the agent-browser
# container. Forms get rsynced into the workspace mount so they live
# wherever you want on the host.
#
# Local mode (BSESSION_LOCAL=1): runs lib/cli.py natively on the host.
# Uses the host's Chrome (better fingerprint vs containerized Chromium,
# no /dev/shm limits, no VNC layer needed). Requires:
#   - agent-browser on PATH (npm i -g agent-browser)
#   - Google Chrome installed (or set CHROME_BIN)
#
# Skill dir derivation (Docker mode only):
#   .../<skill_id>/forms/<basename>.toml  → skill_dir = .../<skill_id>/
#   .../<skill_id>/<basename>.toml        → skill_dir = .../<skill_id>/
set -euo pipefail

# ── Local mode: run natively, skip Docker ────────────────────────────
if [[ "${BSESSION_LOCAL:-}" == "1" ]]; then
    # Resolve repo root relative to this script:
    # <repo>/.claude/skills/bsession/bsession  → climb 3 dirs
    SCRIPT="$(readlink -f "$0" 2>/dev/null || python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$0")"
    SOURCE="$(cd "$(dirname "$SCRIPT")/../../.." && pwd)"

    export BSESSION_STATE_DIR="${BSESSION_STATE_DIR:-$HOME/.bsession/state}"
    export BSESSION_PROFILES_DIR="${BSESSION_PROFILES_DIR:-$BSESSION_STATE_DIR/profiles}"
    export STEALTH_EXT_DIR="${STEALTH_EXT_DIR:-$BSESSION_STATE_DIR/stealth-ext}"
    mkdir -p "$BSESSION_STATE_DIR" "$BSESSION_PROFILES_DIR"

    PYTHONPATH="$SOURCE" exec python3 -m lib.cli "$@"
fi

# ── Docker mode (default) ────────────────────────────────────────────
CONTAINER="agent-browser"
# Override BSESSION_WORKSPACE if your container mounts a different host dir
# (e.g. ~/.openclaw/workspace/bsession when running with docker-compose.openclaw.yml).
WORKSPACE_HOST="${BSESSION_WORKSPACE:-$HOME/.bsession/workspace}"
WORKSPACE_CONTAINER="/workspace"

if ! docker inspect -f '{{.State.Running}}' "$CONTAINER" &>/dev/null; then
    echo "Container '$CONTAINER' is not running. Start with: docker compose up -d" >&2
    echo "(or set BSESSION_LOCAL=1 to skip Docker and run natively)" >&2
    exit 1
fi

ENV_ARGS=()

if [[ -n "${BSESSION_FORM:-}" ]]; then
    if [[ ! -f "$BSESSION_FORM" ]]; then
        echo "form not found: $BSESSION_FORM" >&2
        exit 2
    fi

    FORM_ABS="$(cd "$(dirname "$BSESSION_FORM")" && pwd)/$(basename "$BSESSION_FORM")"
    FORM_DIR="$(dirname "$FORM_ABS")"

    if [[ "$(basename "$FORM_DIR")" == "forms" ]]; then
        SKILL_DIR="$(dirname "$FORM_DIR")"
    else
        SKILL_DIR="$FORM_DIR"
    fi
    SKILL_ID="$(basename "$SKILL_DIR")"
    REL_IN_SKILL="${FORM_ABS#$SKILL_DIR/}"

    STAGED="$WORKSPACE_HOST/$SKILL_ID"
    WORKSPACE_LOGICAL="$(cd "$WORKSPACE_HOST" && pwd)"

    # Skip sync if the form already lives under the workspace mirror.
    if [[ "$SKILL_DIR" != "$WORKSPACE_LOGICAL/$SKILL_ID" ]]; then
        mkdir -p "$STAGED"
        rsync -a "$SKILL_DIR/" "$STAGED/"
    fi

    ENV_ARGS+=(-e "BSESSION_FORM=$WORKSPACE_CONTAINER/$SKILL_ID/$REL_IN_SKILL")
fi

[[ -n "${BSESSION_PROFILE:-}" ]] && ENV_ARGS+=(-e "BSESSION_PROFILE=$BSESSION_PROFILE")

exec docker exec -i "${ENV_ARGS[@]}" "$CONTAINER" python3 -m lib.cli "$@"

# bsession configuration — all optional. Copy to .env (the installer does this
# for you automatically: `cp .env.example .env`). docker compose needs the .env
# file to exist even if every value is left at its default.

# VNC password for the noVNC web client. Blank = no password (open VNC).
VNC_PASSWORD=

# Host + container port for the bsession HTTP API.
BSESSION_API_PORT=18000

# Max concurrent Chrome profiles; least-recently-used ones are evicted beyond this.
BSESSION_MAX_PROFILES=5

# Host directory mounted as /workspace (SQLite state, profiles, captchas).
# Defaults to ~/.bsession/workspace if unset.
# BSESSION_WORKSPACE=
